---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={`${title} | Alpha Crest`}>
  <Header />
  <main id="main" class="legal-page relative overflow-clip pb-28">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_85%_0%,_rgba(28,79,56,0.2),_transparent_70%)]" aria-hidden="true"></div>
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="kicker enter">Legal</p>
      <h1 class="enter mt-6 mb-12 text-4xl font-medium tracking-tight text-white sm:text-5xl" style="--delay:80ms">{title}</h1>
      <div class="prose-legal enter" style="--delay:160ms">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal-page {
    padding-top: calc(var(--header-h) + 4rem);
  }
</style>

---
// Hero "market depth field": an 80×80 book of columns whose heights ebb and flow like order-book depth,
// seen from directly above. Heights and colours are computed on the GPU; per frame the CPU only
// updates a few uniforms. The pointer gathers liquidity under the cursor; clicks send ripples.
---

<div class="absolute inset-0 overflow-clip bg-ink-950/20" data-field>
  <canvas class="field-canvas block h-full w-full"></canvas>
</div>

<style>
  .field-canvas {
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .field-canvas.is-ready {
    opacity: 1;
  }
</style>

<script>
  import {
    BoxGeometry,
    Color,
    InstancedBufferAttribute,
    InstancedBufferGeometry,
    MathUtils,
    Mesh,
    PerspectiveCamera,
    Plane,
    Raycaster,
    Scene,
    ShaderMaterial,
    Vector2,
    Vector3,
    WebGLRenderer,
  } from 'three';

  const COLS = 80;
  const ROWS = 80;
  const SEPARATOR = 2.3;
  const BAR = 1.15;
  const MAX_RIPPLES = 4;
  const RIPPLE_LIFETIME = 2.6; // seconds of field time
  const TIME_SCALE = 0.96; // field-time per second (the original advanced 0.016 per 60 fps frame)
  const STATIC_TIME = 10.4; // first frame, and the only frame under reduced motion (pulse sits near the right edge)

  const vertexShader = /* glsl */ `
    uniform float uTime;
    uniform vec2 uGrid;              // (COLS, ROWS)
    uniform float uSeparator;
    uniform float uBar;
    uniform vec2 uPointer;           // world XZ under the cursor
    uniform float uPointerStrength;  // 0..1, eased in/out on enter/leave
    uniform vec3 uRipples[${MAX_RIPPLES}];  // (x, z, start time); unused slots start far in the past
    uniform vec3 uInk;
    uniform vec3 uPhthalo;
    uniform vec3 uAccent;

    attribute vec2 aCell;            // (ix, iy)

    varying vec3 vColor;
    varying float vFogDepth;

    void main() {
      vec2 world = aCell * uSeparator - (uGrid - 1.0) * uSeparator * 0.5;
      float t = uTime;

      // Slow ambient swell
      float h = 2.4
        + sin(aCell.x * 0.32 + t * 0.8) * 2.0
        + cos(aCell.y * 0.27 + t * 0.55) * 1.6
        + sin((aCell.x + aCell.y) * 0.11 - t * 0.65) * 1.3;

      // A liquidity pulse sweeping across the book
      float sweep = mod(t * 9.0, uGrid.x + 48.0) - 24.0;
      float d = (aCell.x - sweep) / 7.0;
      h += exp(-d * d) * 7.0;

      // Liquidity gathers under the cursor
      vec2 toPointer = (world - uPointer) / (uSeparator * 8.0);
      h += uPointerStrength * exp(-dot(toPointer, toPointer)) * 6.5;

      // Click ripples: an expanding ring lifts columns as it passes, fading out
      for (int i = 0; i < ${MAX_RIPPLES}; i++) {
        float age = t - uRipples[i].z;
        if (age < 0.0 || age > ${RIPPLE_LIFETIME.toFixed(2)}) continue;
        float ring = (distance(world, uRipples[i].xy) - age * 30.0) / 4.5;
        float fade = 1.0 - age / ${RIPPLE_LIFETIME.toFixed(2)};
        h += exp(-ring * ring) * 7.0 * fade * fade;
      }

      h = max(0.4, h);

      vec3 p = position;             // unit box with its base on y = 0
      p.xz = p.xz * uBar + world;
      p.y *= h;

      // Taller columns run hotter: navy -> phthalo -> cyan
      float heat = clamp((h - 1.5) / 8.5, 0.0, 1.0);
      vec3 color = heat < 0.5
        ? mix(uInk, uPhthalo, heat * 2.0)
        : mix(uPhthalo, uAccent, (heat - 0.5) * 2.0);

      // Extruded read: sides darker than tops; the hottest tops catch a little extra light
      float top = step(0.5, normal.y);
      color *= mix(0.5, 1.0, top);
      color += top * smoothstep(0.75, 1.0, heat) * uAccent * 0.18;

      vColor = color;
      vec4 mvPosition = modelViewMatrix * vec4(p, 1.0);
      vFogDepth = -mvPosition.z;
      gl_Position = projectionMatrix * mvPosition;
    }
  `;

  const fragmentShader = /* glsl */ `
    uniform vec3 uFogColor;
    uniform float uFogNear;
    uniform float uFogFar;

    varying vec3 vColor;
    varying float vFogDepth;

    void main() {
      gl_FragColor = vec4(mix(vColor, uFogColor, smoothstep(uFogNear, uFogFar, vFogDepth)), 1.0);
      #include <colorspace_fragment>
    }
  `;

  function initField(root: HTMLElement) {
    const canvas = root.querySelector('canvas');
    if (!canvas) return;
    const hero = root.closest<HTMLElement>('[data-hero]') ?? root;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hoverPointer = window.matchMedia('(hover: hover) and (pointer: fine)');

    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'high-performance' });
    } catch (error) {
      console.warn('Hero field disabled: WebGL is unavailable.', error);
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

    const scene = new Scene();
    const camera = new PerspectiveCamera(50, 1, 1, 1000);
    camera.up.set(0, 0, -1);

    // One unit box drawn COLS×ROWS times; each instance only carries its grid cell
    const box = new BoxGeometry(1, 1, 1).translate(0, 0.5, 0);
    const geometry = new InstancedBufferGeometry();
    geometry.index = box.index;
    geometry.setAttribute('position', box.getAttribute('position'));
    geometry.setAttribute('normal', box.getAttribute('normal'));
    const cells = new Float32Array(COLS * ROWS * 2);
    for (let ix = 0, n = 0; ix < COLS; ix++) {
      for (let iy = 0; iy < ROWS; iy++, n += 2) {
        cells[n] = ix;
        cells[n + 1] = iy;
      }
    }
    geometry.setAttribute('aCell', new InstancedBufferAttribute(cells, 2));
    geometry.instanceCount = COLS * ROWS;

    const ripples = Array.from({ length: MAX_RIPPLES }, () => new Vector3(0, 0, -1e4));
    const uniforms = {
      uTime: { value: STATIC_TIME },
      uGrid: { value: new Vector2(COLS, ROWS) },
      uSeparator: { value: SEPARATOR },
      uBar: { value: BAR },
      uPointer: { value: new Vector2() },
      uPointerStrength: { value: 0 },
      uRipples: { value: ripples },
      // THREE.Color uniforms upload in linear space; <colorspace_fragment> converts back on output
      uInk: { value: new Color('#101a2d') },
      uPhthalo: { value: new Color('#1c4f38') },
      uAccent: { value: new Color('#00f2fe') },
      uFogColor: { value: new Color('#04070d') },
      uFogNear: { value: 0 },
      uFogFar: { value: 1 },
    };

    const mesh = new Mesh(geometry, new ShaderMaterial({ uniforms, vertexShader, fragmentShader }));
    mesh.frustumCulled = false;
    scene.add(mesh);

    const render = () => renderer.render(scene, camera);

    // Fit the camera so ~90% of the book fills the viewport at any aspect ratio
    const resize = () => {
      const width = root.clientWidth;
      const height = root.clientHeight;
      if (!width || !height) return;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      const tanHalfFov = Math.tan(MathUtils.degToRad(camera.fov / 2));
      const y = Math.min(
        (ROWS * SEPARATOR * 0.45) / tanHalfFov,
        (COLS * SEPARATOR * 0.45) / (tanHalfFov * camera.aspect),
      );
      camera.position.set(0, y, 0);
      camera.lookAt(0, 0, 0);
      uniforms.uFogNear.value = y * 0.65;
      uniforms.uFogFar.value = y * 1.75;
      if (!running) render();
    };

    // Pointer → field plane (≈ mean column height)
    const raycaster = new Raycaster();
    const ndc = new Vector2();
    const plane = new Plane(new Vector3(0, 1, 0), -3);
    const hit = new Vector3();
    const projectPointer = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      ndc.set(((event.clientX - rect.left) / rect.width) * 2 - 1, -((event.clientY - rect.top) / rect.height) * 2 + 1);
      raycaster.setFromCamera(ndc, camera);
      return raycaster.ray.intersectPlane(plane, hit) !== null;
    };

    const pointerTarget = new Vector2();
    let pointerInside = false;

    hero.addEventListener('pointermove', (event) => {
      if (!hoverPointer.matches || event.pointerType !== 'mouse' || !projectPointer(event)) return;
      pointerTarget.set(hit.x, hit.z);
      // Entering from rest: start the swell under the cursor instead of sliding in from the last spot
      if (!pointerInside && uniforms.uPointerStrength.value < 0.05) uniforms.uPointer.value.copy(pointerTarget);
      pointerInside = true;
    });
    hero.addEventListener('pointerleave', () => {
      pointerInside = false;
    });

    let nextRipple = 0;
    hero.addEventListener('pointerdown', (event) => {
      if (reducedMotion.matches) return;
      if ((event.target as Element).closest('a, button, input, textarea, select, label')) return;
      if (!projectPointer(event)) return;
      ripples[nextRipple].set(hit.x, hit.z, uniforms.uTime.value);
      nextRipple = (nextRipple + 1) % MAX_RIPPLES;
    });

    // Loop: runs only while visible, in view, motion allowed and the context is alive
    let running = false;
    let frame = 0;
    let last = 0;
    let inView = true;
    let contextLost = false;

    const tick = (now: number) => {
      frame = requestAnimationFrame(tick);
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      uniforms.uTime.value += dt * TIME_SCALE;
      uniforms.uPointer.value.lerp(pointerTarget, 1 - Math.exp(-dt * 6));
      const strength = uniforms.uPointerStrength;
      strength.value += ((pointerInside ? 1 : 0) - strength.value) * (1 - Math.exp(-dt * 3));
      render();
    };

    const start = () => {
      if (running || reducedMotion.matches || !inView || document.hidden || contextLost) return;
      running = true;
      last = performance.now();
      frame = requestAnimationFrame(tick);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) start();
      else stop();
    }).observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return start();
      stop();
      uniforms.uTime.value = STATIC_TIME;
      uniforms.uPointerStrength.value = 0;
      render();
    });

    canvas.addEventListener('webglcontextlost', (event) => {
      event.preventDefault();
      contextLost = true;
      stop();
    });
    canvas.addEventListener('webglcontextrestored', () => {
      contextLost = false;
      render();
      start();
    });

    new ResizeObserver(resize).observe(root);
    resize();
    render();
    requestAnimationFrame(() => canvas.classList.add('is-ready'));
    start();
  }

  document.querySelectorAll<HTMLElement>('[data-field]').forEach(initField);
</script>

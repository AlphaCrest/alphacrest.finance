---
---
<div class="absolute inset-0 w-full h-full overflow-hidden bg-ink-950/20">
  <canvas id="three-canvas" class="w-full h-full block opacity-0 transition-opacity duration-1000"></canvas>
</div>

<script>
  import * as THREE from 'three';

  function initThree() {
    const canvas = document.getElementById('three-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const parent = canvas.parentElement;
    if (!parent) return;

    // Dimensions
    let width = parent.clientWidth;
    let height = parent.clientHeight;

    // Scene
    const scene = new THREE.Scene();

    // Camera - top-down view over the depth field
    const camera = new THREE.PerspectiveCamera(50, width / height, 1, 1000);
    camera.up.set(0, 0, -1);

    // Renderer
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas: canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance'
      });
    } catch (e) {
      console.warn('WebGL not supported or renderer initialization failed, Three.js background disabled.', e);
      return;
    }
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Market depth field: a grid of vertical columns whose heights ebb and
    // flow like order-book depth / volume profiles across a trading desk.
    const COLS = 80;
    const ROWS = 80;
    const SEPARATOR = 2.3;
    const BAR = 1.15;

    const count = COLS * ROWS;

    // Unit box with origin at its base so scaling Y grows the bar upward
    const geometry = new THREE.BoxGeometry(1, 1, 1);
    geometry.translate(0, 0.5, 0);

    const material = new THREE.MeshBasicMaterial({ color: 0xffffff });

    const mesh = new THREE.InstancedMesh(geometry, material, count);
    mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    scene.add(mesh);

    // Brand ramp: deep navy -> phthalo -> cyan accent
    const ink = new THREE.Color('#101a2d');
    const phthalo = new THREE.Color('#1c4f38');
    const accent = new THREE.Color('#00f2fe');
    const tmpColor = new THREE.Color();

    const dummy = new THREE.Object3D();

    // Static XZ layout
    const offsetX = ((COLS - 1) * SEPARATOR) / 2;
    const offsetZ = ((ROWS - 1) * SEPARATOR) / 2;

    function updateCameraPosition() {
      const aspect = camera.aspect;
      const fovRad = THREE.MathUtils.degToRad(camera.fov / 2);
      const halfWidth = (COLS * SEPARATOR) * 0.45;
      const halfDepth = (ROWS * SEPARATOR) * 0.45;

      const yForZ = halfDepth / Math.tan(fovRad);
      const yForX = halfWidth / (Math.tan(fovRad) * aspect);

      const cameraY = Math.min(yForZ, yForX);

      camera.position.set(0, cameraY, 0);
      camera.lookAt(0, 0, 0);

      scene.fog = new THREE.Fog(0x04070d, cameraY * 0.65, cameraY * 1.75);
    }

    updateCameraPosition();

    function barHeight(ix: number, iy: number, t: number): number {
      // Slow ambient swell
      let h = 2.4
        + Math.sin(ix * 0.32 + t * 0.8) * 2.0
        + Math.cos(iy * 0.27 + t * 0.55) * 1.6
        + Math.sin((ix + iy) * 0.11 - t * 0.65) * 1.3;

      // A "liquidity pulse" sweeping across the book
      const sweep = ((t * 9) % (COLS + 48)) - 24;
      const d = (ix - sweep) / 7;
      h += Math.exp(-d * d) * 7.0;

      return Math.max(0.4, h);
    }

    function updateField(t: number) {
      let n = 0;
      for (let ix = 0; ix < COLS; ix++) {
        for (let iy = 0; iy < ROWS; iy++) {
          const h = barHeight(ix, iy, t);

          dummy.position.set(ix * SEPARATOR - offsetX, 0, iy * SEPARATOR - offsetZ);
          dummy.scale.set(BAR, h, BAR);
          dummy.updateMatrix();
          mesh.setMatrixAt(n, dummy.matrix);

          // Taller bars run hotter: navy -> phthalo -> cyan
          const c = Math.min(1, Math.max(0, (h - 1.5) / 8.5));
          if (c < 0.5) {
            tmpColor.copy(ink).lerp(phthalo, c * 2);
          } else {
            tmpColor.copy(phthalo).lerp(accent, (c - 0.5) * 2);
          }
          mesh.setColorAt(n, tmpColor);

          n++;
        }
      }
      mesh.instanceMatrix.needsUpdate = true;
      if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
    }

    // Resize handler
    function onResize() {
      if (!canvas || !parent) return;
      width = parent.clientWidth;
      height = parent.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      updateCameraPosition();
      renderer.setSize(width, height);
    }

    window.addEventListener('resize', onResize);

    // Pause the loop when the hero scrolls out of view
    let inView = true;
    const viewObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { inView = entry.isIntersecting; });
    }, { threshold: 0 });
    viewObserver.observe(parent);

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Animation
    let animationId: number;
    let time = 0;

    function render(t: number) {
      updateField(t);
      renderer.render(scene, camera);
    }

    function animate() {
      animationId = requestAnimationFrame(animate);
      if (!inView) return;
      time += 0.016;
      render(time);
    }

    if (reducedMotion) {
      // Single static frame, no loop
      render(4.2);
    } else {
      animate();
    }

    // Show canvas smoothly once initialized
    canvas.classList.remove('opacity-0');

    // Cleanup on destroy
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.removedNodes.forEach((node) => {
          if (node === parent || node.contains(parent)) {
            window.removeEventListener('resize', onResize);
            cancelAnimationFrame(animationId);
            viewObserver.disconnect();
            renderer.dispose();
            geometry.dispose();
            material.dispose();
            observer.disconnect();
          }
        });
      });
    });

    if (parent.parentElement) {
      observer.observe(parent.parentElement, { childList: true, subtree: true });
    }
  }

  // Support Astro View Transitions if any
  document.addEventListener('astro:page-load', initThree);
  // Default run
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initThree();
  } else {
    document.addEventListener('DOMContentLoaded', initThree);
  }
</script>

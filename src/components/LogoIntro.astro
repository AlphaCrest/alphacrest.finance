    </div>

    <!-- Mark half (left side of logo) — enters from the RIGHT edge -->
    <div class="intro-half intro-mark absolute inset-0">
      <svg viewBox="0 0 593.65 126.22" class="w-full h-auto block" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g>
          <polygon fill="#006add" points="90.3 48.73 71.11 0 45.63 0 68.21 57.33 90.3 48.73"/>
          <polygon fill="#00efd8" points="25.48 104.74 39.85 68.26 9.76 79.97 0 104.74 25.48 104.74"/>
          <polygon fill="#003daa" points="106.78 104.74 85.46 50.62 63.37 59.22 81.3 104.74 106.78 104.74"/>
          <polygon fill="#00ddcd" points="44.93 66.39 71.08 0 45.6 0 14.84 78.09 44.93 66.39"/>
        </g>
      </svg>
    </div>
  </div>
</div>

<style>
  #logo-intro {
    transition: opacity 0.7s ease;
  }

  #logo-intro.play {
    opacity: 1;
    pointer-events: auto;
  }

  #logo-intro.done {
    opacity: 0;
    pointer-events: none;
  }

  .intro-half {
    will-change: transform, opacity;
  }

  /* Wordmark flies in from beyond the left screen edge */
  #logo-intro.play .intro-word {
    animation: intro-from-left 1.15s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  /* Mark flies in from beyond the right screen edge, slightly staggered */
  #logo-intro.play .intro-mark {
    animation: intro-from-right 1.15s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
  }

  /* Settle pulse + glow once the halves meet */
  #logo-intro.play #logo-intro-inner {
    animation: intro-settle 0.6s ease-out 1.4s both;
  }

  @keyframes intro-from-left {
    from {
      transform: translateX(-110vw);
      opacity: 0.4;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes intro-from-right {
    from {
      transform: translateX(110vw);
      opacity: 0.4;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes intro-settle {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

<script>
  const intro = document.getElementById('logo-intro');

  if (intro) {
    const seen = sessionStorage.getItem('ac-intro-seen');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const dismiss = () => {
      intro.classList.add('done');
      document.body.style.overflow = '';
      window.setTimeout(() => intro.remove(), 750);
    };

    if (seen || reducedMotion) {
      intro.remove();
    } else {
      sessionStorage.setItem('ac-intro-seen', '1');
      document.body.style.overflow = 'hidden';
      // Start animations on the next frame so the transition/animation states apply cleanly
      requestAnimationFrame(() => intro.classList.add('play'));

      const timer = window.setTimeout(dismiss, 2300);
      // Allow click to skip
      intro.addEventListener('click', () => {
        window.clearTimeout(timer);
        dismiss();
      }, { once: true });
    }
  }
</script>

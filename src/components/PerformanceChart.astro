---
---
<div class="relative w-full max-w-xl mx-auto glass rounded-[2px] p-6 performance-chart-card">
  <!-- Chart Header -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h4 class="font-mono text-[10px] font-medium tracking-[0.2em] text-slate-400 uppercase">Performance Comparison</h4>
      <p class="text-xs text-slate-500 mt-1">Cumulative performance vs. Benchmark</p>
    </div>
    <div class="text-right">
      <span class="font-mono text-lg font-semibold text-accent">+342.8%</span>
      <span class="text-xs text-emerald-400 block font-semibold">Alpha Crest (Net)</span>
    </div>
  </div>

  <!-- SVG Chart -->
  <div class="relative">
    <svg viewBox="0 0 600 350" class="w-full h-auto" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Grids -->
      <g stroke="#334155" stroke-dasharray="3 3" opacity="0.35">
        <line x1="50" y1="50" x2="550" y2="50" />
        <line x1="50" y1="120" x2="550" y2="120" />
        <line x1="50" y1="190" x2="550" y2="190" />
        <line x1="50" y1="260" x2="550" y2="260" />
      </g>

      <!-- Axes -->
      <line x1="50" y1="300" x2="550" y2="300" stroke="#475569" stroke-width="1.5" />
      <line x1="50" y1="50" x2="50" y2="300" stroke="#475569" stroke-width="1.5" />

      <!-- Y Axis Labels -->
      <text x="25" y="55" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">300%</text>
      <text x="25" y="125" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">200%</text>
      <text x="25" y="195" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">100%</text>
      <text x="25" y="265" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">0%</text>
      
      <!-- X Axis Labels -->
      <text x="50" y="325" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">Q1</text>
      <text x="150" y="325" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">Q2</text>
      <text x="250" y="325" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">Q3</text>
      <text x="350" y="325" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">Q4</text>
      <text x="450" y="325" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">Q5</text>
      <text x="550" y="325" fill="#64748b" font-size="10" font-family="'JetBrains Mono', monospace" text-anchor="middle">Q6</text>

      <!-- Gradient Definitions -->
      <defs>
        <linearGradient id="crestGradient" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#00f2fe" />
          <stop offset="100%" stop-color="#4facfe" />
        </linearGradient>
        <linearGradient id="crestAreaGradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.15" />
          <stop offset="100%" stop-color="#00f2fe" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Benchmark (Volatile, lower return) -->
      <path 
        d="M 50 260 L 100 230 L 150 270 L 200 200 L 250 220 L 300 170 L 350 240 L 400 190 L 450 210 L 500 160 L 550 180" 
        stroke="#475569" 
        stroke-width="1.5" 
        stroke-linecap="round"
        stroke-linejoin="round"
        class="line-benchmark"
      />

      <!-- Alpha Crest (Consistent, upward trend) -->
      <path 
        id="crest-area"
        d="M 50 260 L 100 210 L 150 180 L 200 140 L 250 110 L 300 90 L 350 78 L 400 65 L 450 58 L 500 52 L 550 48 L 550 300 L 50 300 Z" 
        fill="url(#crestAreaGradient)"
        class="area-active"
      />
      <path 
        d="M 50 260 L 100 210 L 150 180 L 200 140 L 250 110 L 300 90 L 350 78 L 400 65 L 450 58 L 500 52 L 550 48" 
        stroke="url(#crestGradient)" 
        stroke-width="2.5" 
        stroke-linecap="round"
        stroke-linejoin="round"
        class="line-active"
      />

      <!-- Accent nodes -->
      <circle cx="550" cy="48" r="5" fill="#00f2fe" class="pulse-node" />
    </svg>
  </div>

  <!-- Legend -->
  <div class="flex justify-center items-center space-x-6 mt-4 text-xs">
    <div class="flex items-center space-x-2">
      <span class="w-3 h-0.5 bg-gradient-to-r from-accent to-accent-2 inline-block rounded-full"></span>
      <span class="text-slate-300 font-medium">Alpha Crest (Algorithmic)</span>
    </div>
    <div class="flex items-center space-x-2">
      <span class="w-3 h-0.5 bg-[#475569] inline-block rounded-full"></span>
      <span class="text-slate-500">Benchmark Index</span>
    </div>
  </div>
</div>

<style>
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.3);
      opacity: 1;
    }
  }

  .line-active {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }

  .line-benchmark {
    /* Static styling: no animation */
  }

  .area-active {
    opacity: 0;
  }

  .pulse-node {
    transform-origin: 550px 48px;
    opacity: 0;
  }

  /* Trigger animations only when performance-chart-card enters viewport */
  .animate-chart .line-active {
    animation: draw 3.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .animate-chart .area-active {
    animation: fadeIn 1.5s ease-out 1.2s forwards;
  }

  .animate-chart .pulse-node {
    animation: pulse 2s infinite ease-in-out;
    opacity: 1;
  }
</style>

<script>
  function initChart() {
    const card = document.querySelector('.performance-chart-card');
    if (!card) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          card.classList.add('animate-chart');
          observer.unobserve(card);
        }
      });
    }, { threshold: 0.1 });
    observer.observe(card);
  }

  document.addEventListener('astro:page-load', initChart);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initChart();
  } else {
    document.addEventListener('DOMContentLoaded', initChart);
  }
</script>

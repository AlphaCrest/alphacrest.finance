---
// Illustrative cumulative-performance chart (marketing figures; keep data and labels as published).
const crest: [number, number][] = [
  [50, 260], [100, 210], [150, 180], [200, 140], [250, 110], [300, 90],
  [350, 78], [400, 65], [450, 58], [500, 52], [550, 48],
];
const benchmark: [number, number][] = [
  [50, 260], [100, 230], [150, 270], [200, 200], [250, 220], [300, 170],
  [350, 240], [400, 190], [450, 210], [500, 160], [550, 180],
];
const [crestLine, benchmarkLine] = [crest, benchmark].map((points) =>
  points.map(([x, y], i) => `${i ? 'L' : 'M'} ${x} ${y}`).join(' '),
);
const gridY = [50, 120, 190, 260];
const yLabels = ['300%', '200%', '100%', '0%'];
const quarters = ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6'];
---

<figure class="glass spotlight relative mx-auto w-full max-w-xl rounded-[2px] p-6 sm:p-7" data-chart>
  <div class="mb-6 flex items-start justify-between gap-6">
    <div>
      <h3 class="font-mono text-[10px] font-medium tracking-[0.2em] text-slate-400 uppercase">Performance Comparison</h3>
      <p class="mt-1 text-xs text-slate-500">Cumulative performance vs. Benchmark</p>
    </div>
    <div class="text-right">
      <span class="sr-only">+342.8%</span>
      <span class="block font-mono text-lg font-semibold text-accent tabular-nums" aria-hidden="true" data-chart-total>+342.8%</span>
      <span class="block text-xs font-semibold text-emerald-400">Alpha Crest (Net)</span>
    </div>
  </div>

  <svg viewBox="0 0 600 350" class="h-auto w-full overflow-visible" fill="none" role="img" aria-labelledby="chart-title chart-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="chart-title">Alpha Crest versus benchmark index, cumulative performance</title>
    <desc id="chart-desc">Illustrative chart: Alpha Crest rises steadily across six quarters while the benchmark index moves erratically at a lower level.</desc>
    <defs>
      <linearGradient id="crestGradient" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#00f2fe"></stop>
        <stop offset="100%" stop-color="#4facfe"></stop>
      </linearGradient>
      <linearGradient id="crestAreaGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.16"></stop>
        <stop offset="100%" stop-color="#00f2fe" stop-opacity="0"></stop>
      </linearGradient>
      <radialGradient id="crestHeadGlow">
        <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.55"></stop>
        <stop offset="100%" stop-color="#00f2fe" stop-opacity="0"></stop>
      </radialGradient>
    </defs>

    <g class="chart-frame">
      <g stroke="#334155" stroke-dasharray="3 3" opacity="0.35">
        {gridY.map((y) => <line x1="50" y1={y} x2="550" y2={y}></line>)}
      </g>
      <g stroke="#475569" stroke-width="1.5">
        <line x1="50" y1="300" x2="550" y2="300"></line>
        <line x1="50" y1="50" x2="50" y2="300"></line>
      </g>
      <g class="font-mono" fill="#64748b" font-size="10" text-anchor="middle">
        {gridY.map((y, i) => <text x="25" y={y + 5}>{yLabels[i]}</text>)}
        {quarters.map((label, i) => <text x={50 + i * 100} y="325">{label}</text>)}
      </g>
    </g>

    <path class="chart-benchmark" d={benchmarkLine} stroke="#475569" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1"></path>
    <path class="chart-area" d={`${crestLine} L 550 300 L 50 300 Z`} fill="url(#crestAreaGradient)"></path>
    <path class="chart-crest" d={crestLine} stroke="url(#crestGradient)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1"></path>

    <!-- Comet head that rides the line while it draws -->
    <g class="chart-head">
      <circle r="10" fill="url(#crestHeadGlow)"></circle>
      <circle r="3" fill="#e6feff"></circle>
    </g>

    <g transform="translate(550 48)">
      <g class="chart-node">
        <circle class="chart-node-ring" r="5" stroke="#00f2fe" stroke-width="1.5"></circle>
        <circle r="5" fill="#00f2fe"></circle>
      </g>
    </g>
  </svg>

  <figcaption class="mt-4 flex items-center justify-center gap-6 text-xs">
    <span class="flex items-center gap-2">
      <span class="inline-block h-0.5 w-3 rounded-full bg-gradient-to-r from-accent to-accent-2"></span>
      <span class="font-medium text-slate-300">Alpha Crest (Algorithmic)</span>
    </span>
    <span class="flex items-center gap-2">
      <span class="inline-block h-0.5 w-3 rounded-full bg-[#475569]"></span>
      <span class="text-slate-500">Benchmark Index</span>
    </span>
  </figcaption>
</figure>

<style>
  .chart-crest {
    filter: drop-shadow(0 0 6px rgb(0 242 254 / 0.45));
  }
  .chart-head {
    opacity: 0;
  }
  .chart-node,
  .chart-node-ring {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Armed (JS, motion allowed): hide everything that will draw in */
  [data-chart].is-armed .chart-frame {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  [data-chart].is-armed .chart-benchmark,
  [data-chart].is-armed .chart-crest {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
  }
  [data-chart].is-armed .chart-area {
    opacity: 0;
    transition: opacity 1.4s ease-out;
  }
  [data-chart].is-armed .chart-node {
    opacity: 0;
    transform: scale(0.3);
    transition:
      opacity 0.4s ease,
      transform 0.7s var(--ease-out-expo);
  }
  [data-chart].is-drawing .chart-frame,
  [data-chart].is-filling .chart-area,
  [data-chart].is-complete .chart-node {
    opacity: 1;
  }
  [data-chart].is-complete .chart-node {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-chart].is-complete .chart-node-ring {
      animation: node-ping 2.4s var(--ease-out-quint) 0.4s infinite;
    }
  }

  @keyframes node-ping {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
</style>

<script>
  const easeOutQuint = (t: number) => 1 - (1 - t) ** 5;
  const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);

  function initChart(root: HTMLElement) {
    const crest = root.querySelector<SVGPathElement>('.chart-crest');
    const benchmark = root.querySelector<SVGPathElement>('.chart-benchmark');
    const head = root.querySelector<SVGGElement>('.chart-head');
    const total = root.querySelector<HTMLElement>('[data-chart-total]');
    if (!crest || !benchmark || !head || !total) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-complete');
      return;
    }

    root.classList.add('is-armed');
    total.textContent = '+0.0%';

    const BENCHMARK_MS = 1500;
    const CREST_DELAY_MS = 350;
    const CREST_MS = 2600;

    const play = () => {
      root.classList.add('is-drawing');
      const length = crest.getTotalLength();
      const start = performance.now();
      const frame = (now: number) => {
        const tb = Math.min(1, (now - start) / BENCHMARK_MS);
        const tc = Math.min(1, Math.max(0, (now - start - CREST_DELAY_MS) / CREST_MS));
        const progress = easeOutQuint(tc);

        benchmark.style.strokeDashoffset = String(1 - easeInOutCubic(tb));
        crest.style.strokeDashoffset = String(1 - progress);

        const point = crest.getPointAtLength(length * progress);
        head.setAttribute('transform', `translate(${point.x} ${point.y})`);
        head.style.opacity = tc > 0 && tc < 1 ? '1' : '0';
        total.textContent = `+${(342.8 * progress).toFixed(1)}%`;
        if (tc > 0.3) root.classList.add('is-filling');

        if (tc < 1) {
          requestAnimationFrame(frame);
        } else {
          total.textContent = '+342.8%';
          root.classList.add('is-complete');
        }
      };
      requestAnimationFrame(frame);
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        play();
      },
      { threshold: 0.35 },
    );
    observer.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-chart]').forEach(initChart);
</script>

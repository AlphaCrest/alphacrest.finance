---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const navigation = [
  { href: '/#home', label: 'Home' },
  { href: '/#about', label: 'About Us' },
  { href: '/#whatweoffer', label: 'What We Offer' },
  { href: '/#team', label: 'Our Team' },
];

const legal = [
  { href: '/regulatory-disclosures/', label: 'Regulatory Disclosures' },
  { href: '/privacy-policy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms of Use' },
];
---

<footer class="relative overflow-clip bg-ink-950 pt-20 text-slate-400">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-4 md:gap-10">
      <!-- Branding & Description -->
      <div class="space-y-6 md:col-span-2">
        <a href="/#home" class="inline-block" aria-label="Alpha Crest — home">
          <Logo class="h-9 w-auto" title="" />
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-slate-400">
          Alpha Crest is a quantitative investment manager specializing in systematic, algorithmically-driven digital asset strategies.
        </p>
        <a
          href="https://www.linkedin.com/company/101651606"
          target="_blank"
          rel="noopener noreferrer"
          class="glass inline-flex size-10 items-center justify-center rounded-[2px] text-slate-400 transition-colors hover:border-accent/30 hover:text-accent"
          aria-label="Alpha Crest on LinkedIn"
        >
          <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
          </svg>
        </a>
      </div>

      <!-- Quick Links -->
      <nav aria-labelledby="footer-navigation" class="space-y-4">
        <h2 id="footer-navigation" class="font-mono text-[10px] font-medium tracking-[0.25em] text-slate-500 uppercase">Navigation</h2>
        <ul class="space-y-2.5 text-sm" role="list">
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} class="link-sweep transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact Info -->
      <div class="space-y-4">
        <h2 class="font-mono text-[10px] font-medium tracking-[0.25em] text-slate-500 uppercase">Contact</h2>
        <ul class="space-y-3 text-sm" role="list">
          <li>
            <span class="block text-xs text-slate-500 uppercase">Email</span>
            <a href="mailto:info@alphacrest.finance" class="link-sweep transition-colors hover:text-white">info@alphacrest.finance</a>
          </li>
          <li>
            <span class="block text-xs text-slate-500 uppercase">Registered Address</span>
            <span class="block leading-relaxed text-slate-400">Cape Town, South Africa</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Legal bar -->
    <div class="mt-16 flex flex-col items-center justify-between gap-6 border-t border-white/[0.06] pt-8 md:flex-row md:items-start">
      <div class="space-y-2 text-center text-xs text-slate-500 md:text-left">
        <p>© {currentYear} Alpha Crest (Pty) Ltd. All rights reserved.</p>
        <p class="max-w-2xl">
          Alpha Crest (Pty) Ltd is not an authorized financial services provider (FSP). Our application is pending with the Financial Services Conduct Authority (FSCA). The fund remains closed pending approval.
        </p>
      </div>
      <div class="flex flex-col items-center gap-4 md:items-end">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-slate-500" role="list">
          {
            legal.map((item) => (
              <li>
                <a href={item.href} class="link-sweep transition-colors hover:text-slate-300">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="#top" class="group inline-flex items-center gap-2 font-mono text-[10px] tracking-[0.2em] text-slate-500 uppercase transition-colors hover:text-accent">
          Back to top
          <svg class="size-3.5 transition-transform duration-300 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Signature: oversized outlined wordmark bleeding off the bottom edge -->
  <div class="footer-signature reveal pointer-events-none mx-auto mt-14 max-w-[100rem] px-4 sm:px-6" aria-hidden="true">
    <Logo variant="wordmark" title="" class="h-auto w-full" />
  </div>
</footer>

<style>
  .footer-signature {
    margin-bottom: -7vw;
    color: transparent;
    -webkit-mask-image: linear-gradient(to bottom, #000 25%, transparent 85%);
    mask-image: linear-gradient(to bottom, #000 25%, transparent 85%);
  }
  .footer-signature :global(.logo-word path) {
    stroke: rgb(255 255 255 / 0.1);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
</style>

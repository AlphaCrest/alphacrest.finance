---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PerformanceChart from '../components/PerformanceChart.astro';
import LogoIntro from '../components/LogoIntro.astro';
import ThreeBackground from '../components/ThreeBackground.astro';

// Fetch team members and sort them in order: Saleem, Fayaadh, Dinesh, Isa, Imaad
const teamMembers = await getCollection('team');
const order = ['saleem-jaffer', 'fayaadh-dhansay', 'dinesh-makan', 'isa-tippens', 'imaad-davies'];
const sortedTeam = [...teamMembers].sort((a, b) => {
  return order.indexOf(a.data.slug) - order.indexOf(b.data.slug);
});
---

<Layout>
  <LogoIntro />
  <Header />

  <!-- Hero Section -->
  <section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-ink-950 pt-20">
    <!-- 3D Interactive Background -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <ThreeBackground />
      <!-- Gradient overlays to ensure text readability and fade into background -->
      <div class="absolute inset-0 bg-gradient-to-b from-ink-950/70 via-ink-950/40 to-ink-950 z-10"></div>
      <!-- Faint blueprint grid -->
      <div class="absolute inset-0 grid-bg z-10"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-24 sm:py-32 reveal">
      <span class="kicker mb-8">Quantitative Investment Fund</span>
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-medium text-white tracking-tight text-balance leading-[1.05] mb-6">
        Beating the Market, <br />
        <span class="text-gradient">
          Algorithmically
        </span>
      </h1>
      <p class="max-w-2xl mx-auto text-lg sm:text-xl text-slate-400 leading-relaxed mb-10">
        Alpha Crest is a private, systematically-driven investment manager. We develop and execute proprietary quantitative strategies within the digital asset markets.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="#about" class="btn-primary w-full sm:w-auto">
          Explore Strategy
        </a>
        <a href="#contact" class="btn-ghost w-full sm:w-auto">
          Get In Touch
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 hidden md:block">
      <a href="#about" class="flex flex-col items-center text-slate-500 hover:text-accent transition-colors" aria-label="Scroll Down">
        <span class="font-mono text-[10px] tracking-[0.25em] uppercase mb-2">Scroll</span>
        <svg class="h-5 w-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </a>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="relative py-24 sm:py-32 bg-ink-950 overflow-hidden">
    <!-- Ambient glow + grid -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_20%_0%,_rgba(28,79,56,0.25),_transparent_70%)]"></div>
    <div class="absolute inset-0 grid-bg"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
        <!-- Text Content -->
        <div class="lg:col-span-6 space-y-8 reveal">
          <span class="kicker">About Alpha Crest</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-medium text-white tracking-tight text-balance leading-tight">
            Revolutionizing Cryptocurrency Trading
          </h2>
          <div class="space-y-6 text-slate-400 leading-relaxed text-base sm:text-lg">
            <p>
              Alpha Crest utilizes a robust, infrastructure-led trading process built entirely on mathematical models, low-latency execution, and high-frequency algorithms.
            </p>
            <p>
              By leveraging advanced statistical techniques and automated risk frameworks, we navigate the complex, high-volatility cryptocurrency landscape, extracting repeatable alpha across global exchanges.
            </p>
          </div>
          <div class="pt-4 flex flex-wrap gap-10">
            <div class="relative pl-5 before:absolute before:left-0 before:top-1 before:bottom-1 before:w-px before:bg-gradient-to-b before:from-accent before:to-transparent">
              <span class="font-mono text-3xl font-semibold text-white block tracking-tight">24/7</span>
              <span class="font-mono text-[10px] text-slate-500 uppercase tracking-[0.2em]">Market Execution</span>
            </div>
            <div class="relative pl-5 before:absolute before:left-0 before:top-1 before:bottom-1 before:w-px before:bg-gradient-to-b before:from-accent before:to-transparent">
              <span class="font-mono text-3xl font-semibold text-white block tracking-tight">100%</span>
              <span class="font-mono text-[10px] text-slate-500 uppercase tracking-[0.2em]">Systematic & Quantitative</span>
            </div>
          </div>
        </div>

        <!-- Performance Chart Illustration -->
        <div class="lg:col-span-6 w-full reveal reveal-delay-200">
          <PerformanceChart />
        </div>
      </div>
    </div>
  </section>

  <!-- What We Offer Section -->
  <section id="whatweoffer" class="py-24 sm:py-32 bg-ink-950 relative border-y border-white/[0.04] overflow-hidden">
    <!-- Video Background for What We Offer -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <video 
        autoplay 
        loop 
        muted 
        playsinline 
        class="w-full h-full object-cover opacity-45"
      >
        <source src="/assets/Slider-Vid.mp4" type="video/mp4" />
      </video>
      <!-- Gradient overlays to ensure text readability and fade into neighboring sections -->
      <div class="absolute inset-0 bg-gradient-to-b from-ink-950 via-ink-950/70 to-ink-950 z-10"></div>
      <!-- Faint blueprint grid -->
      <div class="absolute inset-0 grid-bg z-10"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16 relative z-10">
      <div class="text-center max-w-3xl mx-auto space-y-4 reveal">
        <span class="kicker">Our Edge</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-medium text-white tracking-tight text-balance">What We Offer</h2>
        <p class="text-slate-400 text-base sm:text-lg">
          Our core pillars outline how we approach markets, structure strategies, and achieve long-term, compounding success.
        </p>
      </div>
    </div>

    <!-- Connected Full-Width Grid with Hairline Dividers -->
    <div class="relative w-full border-t border-b border-white/[0.08] bg-ink-950/40 z-10">
      <!-- Vertical hairlines for desktop -->
      <div class="hidden md:block absolute left-[33.333%] top-0 bottom-0 w-[1px] bg-white/[0.08] z-20"></div>
      <div class="hidden md:block absolute left-[66.666%] top-0 bottom-0 w-[1px] bg-white/[0.08] z-20"></div>

      <!-- Quiet highlight for the middle card (Strategy) on desktop -->
      <div class="hidden md:block absolute inset-y-0 left-[33.333%] right-[33.333%] bg-accent/[0.03] z-0"></div>

      <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-0 relative z-10">
        <!-- Opportunity Card -->
        <div class="relative px-12 md:px-16 lg:px-24 py-16 md:py-24 flex flex-col justify-between hover:bg-white/[0.02] transition-all duration-300 reveal reveal-delay-100 group min-h-[350px]">
          <div>
            <div class="h-12 w-12 rounded-[2px] bg-accent/[0.07] flex items-center justify-center mb-8 border border-accent/15 group-hover:border-accent/35 transition-all duration-300">
              <img src="/assets/Opportunity.png" alt="Opportunity Icon" class="h-6 w-6 object-contain" />
            </div>
            <h3 class="text-2xl font-display font-medium text-white mb-4">Opportunity</h3>
            <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
              Cryptocurrency markets represent an inefficient, highly volatile asset class. We view this structural volatility not as risk, but as a rich environment for capturing alpha.
            </p>
          </div>
        </div>

        <!-- Mobile Divider 1 -->
        <div class="block md:hidden w-full h-[1px] bg-white/[0.06]"></div>

        <!-- Strategy Card -->
        <div class="relative px-12 md:px-16 lg:px-24 py-16 md:py-24 flex flex-col justify-between hover:bg-white/[0.02] transition-all duration-300 reveal reveal-delay-200 group min-h-[350px]">
          <div>
            <div class="h-12 w-12 rounded-[2px] bg-accent/[0.07] flex items-center justify-center mb-8 border border-accent/15 group-hover:border-accent/35 transition-all duration-300">
              <img src="/assets/Strategy.png" alt="Strategy Icon" class="h-6 w-6 object-contain" />
            </div>
            <h3 class="text-2xl font-display font-medium text-white mb-4">Strategy</h3>
            <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
              We develop systematic, proprietary algorithms designed to capture mathematical edge. Every strategy is thoroughly back-tested and stress-tested before deployment.
            </p>
          </div>
        </div>

        <!-- Mobile Divider 2 -->
        <div class="block md:hidden w-full h-[1px] bg-white/[0.06]"></div>

        <!-- Purpose Card -->
        <div class="relative px-12 md:px-16 lg:px-24 py-16 md:py-24 flex flex-col justify-between hover:bg-white/[0.02] transition-all duration-300 reveal reveal-delay-300 group min-h-[350px]">
          <div>
            <div class="h-12 w-12 rounded-[2px] bg-accent/[0.07] flex items-center justify-center mb-8 border border-accent/15 group-hover:border-accent/35 transition-all duration-300">
              <img src="/assets/Purpose.png" alt="Purpose Icon" class="h-6 w-6 object-contain" />
            </div>
            <h3 class="text-2xl font-display font-medium text-white mb-4">Purpose</h3>
            <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
              Our alignment is pure: we focus on compounding capital with high risk-adjusted returns, working with partners who share our long-term perspective.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Venues Section -->
  <section class="py-16 bg-ink-950 border-b border-white/[0.04] reveal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-mono text-[10px] font-medium tracking-[0.25em] text-slate-500 uppercase mb-8">Integrated Venues & Liquidity Partners</p>
      <div class="flex justify-center items-center opacity-35 hover:opacity-70 transition-opacity duration-500">
        <img src="/assets/Luno.png" alt="Luno Logo" class="h-12 w-auto object-contain" />
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section id="team" class="py-24 sm:py-32 bg-ink-900 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_80%_0%,_rgba(28,79,56,0.22),_transparent_70%)]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-20 space-y-4 reveal">
        <span class="kicker">The Team</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-medium text-white tracking-tight text-balance">Our Specialists</h2>
        <p class="text-slate-400 text-base sm:text-lg">
          Meet the engineers, analysts, and directors designing the algorithms and scaling the systems behind Alpha Crest.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedTeam.map((member, index) => {
          const { name, role, image, slug, bio } = member.data;
          const snippet = bio[0];
          return (
            <div class={`group relative rounded-[2px] glass glass-hover overflow-hidden flex flex-col justify-between hover:-translate-y-1.5 reveal ${index === 0 ? 'reveal-delay-100' : index === 1 ? 'reveal-delay-200' : index === 2 ? 'reveal-delay-300' : index === 3 ? 'reveal-delay-100' : 'reveal-delay-200'}`}>
              <div>
                <!-- Member Image -->
                <div class="aspect-[4/3] w-full overflow-hidden relative bg-ink-950">
                  <img 
                    src={image} 
                    alt={name} 
                    class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-transparent to-transparent opacity-80"></div>
                </div>

                <!-- Info -->
                <div class="p-6">
                  <h3 class="text-xl font-display font-medium text-white tracking-tight mb-2">{name}</h3>
                  <span class="font-mono text-[10px] font-medium tracking-[0.2em] text-accent uppercase block mb-4">{role}</span>
                  <p class="text-sm text-slate-400 line-clamp-3 leading-relaxed">
                    {snippet}
                  </p>
                </div>
              </div>

              <!-- Action Link -->
              <div class="px-6 pb-6 pt-2">
                <a 
                  href={`/${slug}/`} 
                  class="inline-flex items-center font-mono text-[11px] font-medium text-accent hover:text-white uppercase tracking-[0.18em] group/link transition-colors"
                >
                  Read Full Bio
                  <svg class="h-4 w-4 ml-1.5 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 sm:py-32 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_10%_100%,_rgba(28,79,56,0.22),_transparent_70%)]"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        <!-- Info Column -->
        <div class="lg:col-span-5 space-y-8 reveal">
          <div class="space-y-4">
            <span class="kicker">Contact</span>
            <h2 class="text-3xl sm:text-4xl font-display font-medium text-white tracking-tight text-balance">Get in Touch</h2>
            <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
              If you are interested in our trading strategies, operational compliance, or carrier opportunities, please contact us.
            </p>
          </div>

          <div class="space-y-6 pt-4">
            <div class="flex items-start space-x-4">
              <div class="p-2.5 bg-accent/[0.07] border border-accent/15 rounded-[2px] text-accent">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <span class="block font-mono text-[10px] text-slate-500 uppercase tracking-[0.2em] mb-1">Email Us</span>
                <a href="mailto:info@alphacrest.finance" class="text-base font-medium text-slate-200 hover:text-accent transition-colors">
                  info@alphacrest.finance
                </a>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="p-2.5 bg-accent/[0.07] border border-accent/15 rounded-[2px] text-accent">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <span class="block font-mono text-[10px] text-slate-500 uppercase tracking-[0.2em] mb-1">Location</span>
                <span class="text-base text-slate-200">Cape Town, South Africa</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <div class="lg:col-span-7 glass rounded-[2px] p-8 sm:p-10 relative reveal reveal-delay-200">
          <form class="space-y-6" onsubmit="event.preventDefault(); alert('Message sent successfully!');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="font-mono text-[10px] font-medium text-slate-400 uppercase tracking-[0.2em]">Full Name</label>
                <input 
                  type="text" 
                  id="name" 
                  required
                  placeholder="John Doe"
                  class="w-full px-4 py-3 rounded-[2px] bg-ink-850 border border-white/[0.07] focus:border-accent/60 focus:ring-1 focus:ring-accent/30 text-white placeholder-slate-600 transition-all outline-none text-sm"
                />
              </div>
              <div class="space-y-2">
                <label for="email" class="font-mono text-[10px] font-medium text-slate-400 uppercase tracking-[0.2em]">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  required
                  placeholder="john@example.com"
                  class="w-full px-4 py-3 rounded-[2px] bg-ink-850 border border-white/[0.07] focus:border-accent/60 focus:ring-1 focus:ring-accent/30 text-white placeholder-slate-600 transition-all outline-none text-sm"
                />
              </div>
            </div>
            
            <div class="space-y-2">
              <label for="message" class="font-mono text-[10px] font-medium text-slate-400 uppercase tracking-[0.2em]">Message</label>
              <textarea 
                id="message" 
                rows="5"
                required
                placeholder="Hi, I would like to query..."
                class="w-full px-4 py-3 rounded-[2px] bg-ink-850 border border-white/[0.07] focus:border-accent/60 focus:ring-1 focus:ring-accent/30 text-white placeholder-slate-600 transition-all outline-none text-sm resize-none"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full cursor-pointer">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

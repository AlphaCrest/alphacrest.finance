---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PerformanceChart from '../components/PerformanceChart.astro';
import ThreeBackground from '../components/ThreeBackground.astro';
import { getSortedTeam } from '../lib/team';

const team = await getSortedTeam();

// Hero headline, split into words so each can rise out of its own mask
const headline = [
  { words: ['Beating', 'the', 'Market,'], accent: false },
  { words: ['Algorithmically'], accent: true },
];

const pillars = [
  {
    title: 'Opportunity',
    icon: { src: '/assets/Opportunity.png', width: 77, height: 76 },
    body: 'Cryptocurrency markets represent an inefficient, highly volatile asset class. We view this structural volatility not as risk, but as a rich environment for capturing alpha.',
    featured: false,
  },
  {
    title: 'Strategy',
    icon: { src: '/assets/Strategy.png', width: 68, height: 76 },
    body: 'We develop systematic, proprietary algorithms designed to capture mathematical edge. Every strategy is thoroughly back-tested and stress-tested before deployment.',
    featured: true,
  },
  {
    title: 'Purpose',
    icon: { src: '/assets/Purpose.png', width: 66, height: 71 },
    body: 'Our alignment is pure: we focus on compounding capital with high risk-adjusted returns, working with partners who share our long-term perspective.',
    featured: false,
  },
];

const arrowPath = 'M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3';
---

<Layout>
  <Header />

  <main id="main">
    <!-- Hero -->
    <section id="home" data-hero class="hero relative isolate flex min-h-svh items-center justify-center overflow-clip bg-ink-950 pt-32 pb-24">
      <div class="absolute inset-0 -z-10 overflow-clip" aria-hidden="true">
        <ThreeBackground />
        <div class="hero-vignette absolute inset-0"></div>
        <div class="grid-bg absolute inset-0"></div>
      </div>

      <div class="hero-content mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <p class="kicker enter mb-8" style="--delay:80ms">Quantitative Investment Fund</p>
        <h1 class="mb-7 text-[2.75rem] leading-[1.04] font-medium tracking-tight text-white sm:text-6xl lg:text-7xl xl:text-[5.25rem]">
          {
            headline.map((line, lineIndex) => (
              <Fragment>
                <span class="block">
                  {line.words.map((word, wordIndex) => (
                    <Fragment>
                      <span class="word-mask">
                        <span
                          class:list={['word', line.accent && 'text-gradient shimmer-once']}
                          style={`--delay:${200 + (lineIndex * 3 + wordIndex) * 80}ms`}
                        >
                          {word}
                        </span>
                      </span>
                      {wordIndex < line.words.length - 1 && ' '}
                    </Fragment>
                  ))}
                </span>
                {lineIndex < headline.length - 1 && ' '}
              </Fragment>
            ))
          }
        </h1>
        <p class="enter mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-slate-400 sm:text-xl" style="--delay:640ms">
          Alpha Crest is a private, systematically-driven investment manager. We develop and execute proprietary quantitative strategies within the digital asset markets.
        </p>
        <div class="enter flex flex-col items-center justify-center gap-4 sm:flex-row" style="--delay:780ms">
          <a href="#about" class="btn-primary w-full sm:w-auto" data-magnetic>
            Explore Strategy
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={arrowPath}></path>
            </svg>
          </a>
          <a href="#contact" class="btn-ghost w-full sm:w-auto" data-magnetic>Get In Touch</a>
        </div>
      </div>

      <!-- Scroll cue -->
      <a href="#about" class="scroll-cue enter absolute inset-x-0 bottom-8 mx-auto hidden w-fit flex-col items-center gap-3 text-slate-500 transition-colors hover:text-accent md:flex" style="--delay:1100ms" aria-label="Scroll to About">
        <span class="font-mono text-[10px] tracking-[0.25em] uppercase">Scroll</span>
        <span class="scroll-cue-line" aria-hidden="true"></span>
      </a>
    </section>

    <!-- About -->
    <section id="about" class="relative overflow-clip bg-ink-950 py-24 sm:py-32">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_20%_0%,_rgba(28,79,56,0.25),_transparent_70%)]" aria-hidden="true"></div>
      <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12">
          <div class="space-y-8 lg:col-span-6">
            <p class="kicker reveal">About Alpha Crest</p>
            <h2 class="reveal text-3xl leading-tight font-medium tracking-tight text-white sm:text-4xl lg:text-5xl" style="--delay:80ms">
              Revolutionizing Cryptocurrency Trading
            </h2>
            <div class="reveal space-y-6 text-base leading-relaxed text-slate-400 sm:text-lg" style="--delay:160ms">
              <p>
                Alpha Crest utilizes a robust, infrastructure-led trading process built entirely on mathematical models, low-latency execution, and high-frequency algorithms.
              </p>
              <p>
                By leveraging advanced statistical techniques and automated risk frameworks, we navigate the complex, high-volatility cryptocurrency landscape, extracting repeatable alpha across global exchanges.
              </p>
            </div>
            <dl class="reveal flex flex-wrap gap-10 pt-4" style="--delay:240ms">
              <div class="stat flex flex-col-reverse">
                <dt class="font-mono text-[10px] tracking-[0.2em] text-slate-500 uppercase">Market Execution</dt>
                <dd class="font-mono text-3xl font-semibold tracking-tight text-white tabular-nums">
                  <span class="sr-only">24/7</span>
                  <span aria-hidden="true" data-count="24" data-suffix="/7">24/7</span>
                </dd>
              </div>
              <div class="stat flex flex-col-reverse">
                <dt class="font-mono text-[10px] tracking-[0.2em] text-slate-500 uppercase">Systematic &amp; Quantitative</dt>
                <dd class="font-mono text-3xl font-semibold tracking-tight text-white tabular-nums">
                  <span class="sr-only">100%</span>
                  <span aria-hidden="true" data-count="100" data-suffix="%">100%</span>
                </dd>
              </div>
            </dl>
          </div>

          <div class="reveal w-full lg:col-span-6" style="--delay:200ms">
            <PerformanceChart />
          </div>
        </div>
      </div>
    </section>

    <!-- What We Offer -->
    <section id="whatweoffer" class="relative isolate overflow-clip border-y border-white/[0.04] bg-ink-950 py-24 sm:py-32">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <video
          class="offer-video absolute inset-0 h-full w-full object-cover"
          muted
          loop
          playsinline
          preload="none"
          poster="/assets/offer-loop-poster.webp"
          data-lazy-video
        >
          <source src="/assets/offer-loop.mp4" type="video/mp4" />
        </video>
        <div class="grid-bg absolute inset-0"></div>
      </div>

      <div class="mx-auto mb-16 max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl space-y-4 text-center">
          <p class="kicker reveal">Our Edge</p>
          <h2 class="reveal text-3xl font-medium tracking-tight text-white sm:text-4xl lg:text-5xl" style="--delay:80ms">What We Offer</h2>
          <p class="reveal text-base text-slate-400 sm:text-lg" style="--delay:160ms">
            Our core pillars outline how we approach markets, structure strategies, and achieve long-term, compounding success.
          </p>
        </div>
      </div>

      <div class="border-y border-white/[0.08] bg-ink-950/40 backdrop-blur-[2px]">
        <ol class="grid grid-cols-1 md:grid-cols-3" role="list">
          {
            pillars.map((pillar, index) => (
              <li class:list={['reveal border-white/[0.08]', index > 0 && 'border-t md:border-t-0 md:border-l', pillar.featured && 'bg-accent/[0.03]']} style={`--delay:${index * 110}ms`}>
                <article class="spotlight group flex h-full min-h-[22rem] flex-col px-8 py-14 sm:px-12 md:py-20 lg:px-16 xl:px-24">
                  <div class="mb-10 flex items-center justify-between">
                    <div class="flex size-12 items-center justify-center rounded-[2px] border border-accent/15 bg-accent/[0.07] transition-colors duration-300 group-hover:border-accent/40">
                      <img src={pillar.icon.src} alt="" width={pillar.icon.width} height={pillar.icon.height} class="size-6 object-contain" loading="lazy" decoding="async" />
                    </div>
                    <span class="font-mono text-[11px] tracking-[0.2em] text-slate-500">{String(index + 1).padStart(2, '0')}</span>
                  </div>
                  <h3 class="mb-4 text-2xl font-medium text-white">{pillar.title}</h3>
                  <p class="max-w-sm text-sm leading-relaxed text-slate-400">{pillar.body}</p>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Venues -->
    <section aria-labelledby="venues-title" class="border-b border-white/[0.04] bg-ink-950 py-16">
      <div class="reveal mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <div class="mb-8 flex items-center justify-center gap-4">
          <span class="h-px w-10 bg-gradient-to-l from-white/20 to-transparent sm:w-16" aria-hidden="true"></span>
          <h2 id="venues-title" class="font-mono text-[10px] font-medium tracking-[0.25em] text-slate-500 uppercase">
            Integrated Venues &amp; Liquidity Partners
          </h2>
          <span class="h-px w-10 bg-gradient-to-r from-white/20 to-transparent sm:w-16" aria-hidden="true"></span>
        </div>
        <img src="/assets/Luno.png" alt="Luno" width="204" height="74" class="venue-logo mx-auto h-12 w-auto" loading="lazy" decoding="async" />
      </div>
    </section>

    <!-- Team -->
    <section id="team" class="relative overflow-clip bg-ink-900 py-24 sm:py-32">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_80%_0%,_rgba(28,79,56,0.22),_transparent_70%)]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-20 max-w-3xl space-y-4 text-center">
          <p class="kicker reveal">The Team</p>
          <h2 class="reveal text-3xl font-medium tracking-tight text-white sm:text-4xl lg:text-5xl" style="--delay:80ms">Our Specialists</h2>
          <p class="reveal text-base text-slate-400 sm:text-lg" style="--delay:160ms">
            Meet the engineers, analysts, and directors designing the algorithms and scaling the systems behind Alpha Crest.
          </p>
        </div>

        <ul class="flex flex-wrap justify-center gap-8" role="list">
          {
            team.map((member, index) => {
              const { name, role, image, slug, bio } = member.data;
              return (
                <li class="reveal w-full sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)]" style={`--delay:${(index % 3) * 100}ms`}>
                  <article class="team-card glass spotlight group relative flex h-full flex-col rounded-[2px]">
                    <div class="relative overflow-clip rounded-t-[2px] bg-ink-950">
                      <Image
                        src={image}
                        alt=""
                        class="aspect-[6/5] w-full object-cover object-top transition-transform duration-700 ease-out-expo group-hover:scale-[1.04]"
                        style={`view-transition-name: photo-${slug}`}
                      />
                      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900 via-transparent to-transparent opacity-80"></div>
                    </div>
                    <div class="flex flex-1 flex-col p-6">
                      <h3 class="w-fit text-xl font-medium tracking-tight text-white" style={`view-transition-name: name-${slug}`}>{name}</h3>
                      <p class="mt-2 font-mono text-[10px] font-medium tracking-[0.2em] text-accent uppercase">{role}</p>
                      <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-slate-400">{bio[0]}</p>
                      <a
                        href={`/${slug}/`}
                        class="team-link mt-auto inline-flex items-center gap-2 pt-6 font-mono text-[11px] font-medium tracking-[0.18em] text-accent uppercase transition-colors group-hover:text-white"
                      >
                        Read Full Bio
                        <span class="sr-only">: {name}</span>
                        <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d={arrowPath}></path>
                        </svg>
                      </a>
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="relative overflow-clip bg-ink-950 py-24 sm:py-32">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_10%_100%,_rgba(28,79,56,0.22),_transparent_70%)]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
          <div class="space-y-8 lg:col-span-5">
            <div class="space-y-4">
              <p class="kicker reveal">Contact</p>
              <h2 class="reveal text-3xl font-medium tracking-tight text-white sm:text-4xl" style="--delay:80ms">Get in Touch</h2>
              <p class="reveal text-base leading-relaxed text-slate-400 sm:text-lg" style="--delay:160ms">
                If you are interested in our trading strategies, operational compliance, or career opportunities, please contact us.
              </p>
            </div>

            <ul class="reveal space-y-6 pt-4" style="--delay:240ms" role="list">
              <li class="flex items-start gap-4">
                <span class="rounded-[2px] border border-accent/15 bg-accent/[0.07] p-2.5 text-accent" aria-hidden="true">
                  <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"></path>
                  </svg>
                </span>
                <div>
                  <span class="mb-1 block font-mono text-[10px] tracking-[0.2em] text-slate-500 uppercase">Email Us</span>
                  <div class="flex items-center gap-3">
                    <a href="mailto:info@alphacrest.finance" class="link-sweep text-base font-medium text-slate-200 hover:text-accent">info@alphacrest.finance</a>
                    <button type="button" class="copy-button inline-flex size-8 items-center justify-center rounded-[2px] text-slate-500 transition-colors hover:bg-white/5 hover:text-accent" data-copy="info@alphacrest.finance" aria-label="Copy email address">
                      <svg class="icon-copy size-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v8.25A2.25 2.25 0 0 0 6 16.5h2.25m8.25-8.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-7.5A2.25 2.25 0 0 1 8.25 18v-1.5m8.25-8.25h-6a2.25 2.25 0 0 0-2.25 2.25v6"></path>
                      </svg>
                      <svg class="icon-check size-4 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"></path>
                      </svg>
                    </button>
                    <span class="copy-feedback font-mono text-[10px] tracking-[0.2em] text-accent uppercase" role="status" data-copy-feedback></span>
                  </div>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <span class="rounded-[2px] border border-accent/15 bg-accent/[0.07] p-2.5 text-accent" aria-hidden="true">
                  <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
                  </svg>
                </span>
                <div>
                  <span class="mb-1 block font-mono text-[10px] tracking-[0.2em] text-slate-500 uppercase">Location</span>
                  <span class="text-base text-slate-200">Cape Town, South Africa</span>
                </div>
              </li>
            </ul>
          </div>

          <div class="reveal lg:col-span-7" style="--delay:200ms">
            <div class="glass spotlight rounded-[2px] p-8 sm:p-10">
              <form id="contact-form" class="space-y-6">
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                  <div class="space-y-2">
                    <label for="name" class="field-label">Full Name</label>
                    <input id="name" name="name" type="text" required autocomplete="name" placeholder="John Doe" class="field" />
                  </div>
                  <div class="space-y-2">
                    <label for="email" class="field-label">Email Address</label>
                    <input id="email" name="email" type="email" required autocomplete="email" placeholder="john@example.com" class="field" />
                  </div>
                </div>
                <div class="space-y-2">
                  <label for="message" class="field-label">Message</label>
                  <textarea id="message" name="message" rows="5" required placeholder="Hi, I would like to query..." class="field resize-none"></textarea>
                </div>
                <button type="submit" class="btn-primary w-full" data-magnetic>
                  Send Message
                  <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"></path>
                  </svg>
                </button>
                <p class="text-center text-xs text-slate-500">Opens your email app with your message pre-filled.</p>
                <p class="contact-status text-center text-sm text-accent" role="status" data-contact-status></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero-vignette {
    background:
      radial-gradient(ellipse 58% 52% at 50% 50%, rgb(4 7 13 / 0.72), rgb(4 7 13 / 0.3) 62%, transparent 100%),
      linear-gradient(to bottom, rgb(4 7 13 / 0.6), transparent 24%, transparent 68%, var(--color-ink-950));
  }

  /* Hero content lifts away as the hero scrolls out (scroll-driven, where supported) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero {
        view-timeline: --hero block;
      }
      /* Longhands on purpose: the CSS minifier folds `animation` + `animation-timeline` into one
         shorthand that Chromium rejects, which silently disables the effect */
      .hero-content {
        animation-name: hero-exit;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 75%;
      }
    }
  }
  @keyframes hero-exit {
    to {
      opacity: 0;
      transform: translate3d(0, -3rem, 0) scale(0.97);
      filter: blur(6px);
    }
  }

  .scroll-cue-line {
    position: relative;
    display: block;
    width: 1px;
    height: 2.5rem;
    overflow: hidden;
    background: rgb(255 255 255 / 0.12);
  }
  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 40%;
    background: linear-gradient(to bottom, transparent, var(--color-accent));
    animation: cue-travel 2.2s var(--ease-in-out-circ) infinite;
  }
  @keyframes cue-travel {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(250%);
    }
  }

  .offer-video {
    opacity: 0.6;
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 28%, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 28%, #000 72%, transparent);
  }

  .venue-logo {
    opacity: 0.45;
    filter: grayscale(1) brightness(1.5);
    transition:
      opacity 0.5s ease,
      filter 0.5s ease;
  }
  .venue-logo:hover {
    opacity: 0.95;
    filter: none;
  }

  .stat {
    position: relative;
    padding-left: 1.25rem;
  }
  .stat::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
  }

  /* Whole card is the link target; the focus ring moves to the card */
  .team-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .team-link:focus-visible {
    outline: none;
  }
  .team-card:has(.team-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .copy-button .icon-check,
  .copy-button[data-copied] .icon-copy {
    display: none;
  }
  .copy-button[data-copied] .icon-check {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-line::after {
      animation: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Background video: fetched and played only while near the viewport; poster only under reduced motion
  const video = document.querySelector<HTMLVideoElement>('[data-lazy-video]');
  if (video) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !reducedMotion.matches) {
          video.play().catch(() => {
            // Autoplay refused (e.g. data saver): the poster stays
          });
        } else {
          video.pause();
        }
      },
      { rootMargin: '200px 0px' },
    ).observe(video);
  }

  // Copy email address
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy]');
  const copyFeedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  let copyTimer = 0;
  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copyButton.dataset.copy ?? '');
    } catch {
      // Clipboard unavailable (permissions/insecure context): the address stays visible for manual copy
      return;
    }
    copyButton.dataset.copied = '';
    if (copyFeedback) copyFeedback.textContent = 'Copied';
    window.clearTimeout(copyTimer);
    copyTimer = window.setTimeout(() => {
      delete copyButton.dataset.copied;
      if (copyFeedback) copyFeedback.textContent = '';
    }, 1800);
  });

  // Contact form → the visitor's email app, pre-addressed and pre-filled
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');
  if (form) {
    const requiredText = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('#name, #message')];
    form.addEventListener('input', (event) => {
      const field = event.target as HTMLInputElement | HTMLTextAreaElement;
      field.setCustomValidity('');
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      // `required` accepts whitespace-only input; reject it explicitly
      for (const field of requiredText) {
        field.setCustomValidity(field.value.trim() ? '' : 'Please fill out this field.');
      }
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const name = String(data.get('name')).trim();
      const email = String(data.get('email')).trim();
      const message = String(data.get('message')).trim();
      const subject = `Website enquiry from ${name}`;
      const body = `${message}\n\n—\n${name}\n${email}`;

      const mailto = document.createElement('a');
      mailto.href = `mailto:info@alphacrest.finance?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      mailto.click();

      if (status) {
        status.textContent = 'Your email app should now open with the message ready to send. If it doesn’t, email info@alphacrest.finance directly.';
      }
    });
  }
</script>

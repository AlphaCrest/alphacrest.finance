---
import { Image } from 'astro:assets';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSortedTeam } from '../lib/team';

export const getStaticPaths = (async () => {
  const team = await getSortedTeam();
  return team.map((member, index) => ({
    params: { member: member.data.slug },
    props: {
      member,
      prev: team[(index - 1 + team.length) % team.length],
      next: team[(index + 1) % team.length],
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { member, prev, next } = Astro.props;
const { name, role, image, slug, bio } = member.data;
const [lead, ...rest] = bio;

const neighbours = [
  { entry: prev, label: 'Previous', direction: 'prev' },
  { entry: next, label: 'Next', direction: 'next' },
] as const;
---

<Layout title={`${name} - ${role} | Alpha Crest`} description={`Read about ${name}, ${role} at Alpha Crest.`}>
  <Header />

  <main id="main" class="member-page relative overflow-clip pb-24">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_55%_45%_at_15%_0%,_rgba(28,79,56,0.22),_transparent_70%)]" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <a href="/#team" class="enter group inline-flex items-center gap-2 font-mono text-[11px] font-medium tracking-[0.18em] text-slate-400 uppercase transition-colors hover:text-accent">
        <svg class="size-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
        </svg>
        Back to Team
      </a>

      <div class="mt-10 grid grid-cols-1 items-start gap-12 md:grid-cols-12 lg:gap-16">
        <!-- Portrait -->
        <div class="md:sticky md:top-[calc(var(--header-h)+2rem)] md:col-span-5">
          <div class="glass relative overflow-clip rounded-[2px] bg-ink-900">
            <Image
              src={image}
              alt={`Portrait of ${name}`}
              class="aspect-[6/5] w-full object-cover object-top"
              style={`view-transition-name: photo-${slug}`}
              loading="eager"
              fetchpriority="high"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
          </div>
        </div>

        <!-- Bio -->
        <div class="md:col-span-7">
          <p class="kicker enter" style="--delay:60ms">The Team</p>
          <h1 class="mt-5 w-fit text-4xl font-medium tracking-tight text-white sm:text-5xl lg:text-6xl" style={`view-transition-name: name-${slug}`}>
            {name}
          </h1>
          <p class="enter mt-5 inline-block rounded-[2px] border border-accent/20 bg-accent/[0.07] px-3 py-1.5 font-mono text-[10px] font-medium tracking-[0.2em] text-accent uppercase" style="--delay:140ms">
            {role}
          </p>
          <div class="enter mt-10 space-y-6 text-base leading-relaxed text-slate-400 lg:text-lg" style="--delay:220ms">
            <p class="text-lg leading-relaxed text-slate-200 lg:text-xl">{lead}</p>
            {rest.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>

      <!-- Previous / next member -->
      <nav aria-label="More team members" class="mt-20 grid grid-cols-2 gap-4 border-t border-white/[0.06] pt-10">
        {
          neighbours.map(({ entry, label, direction }) => (
            <a
              href={`/${entry.data.slug}/`}
              class:list={[
                'glass spotlight group flex items-center gap-4 rounded-[2px] p-3 sm:p-4',
                direction === 'next' && 'flex-row-reverse text-right',
              ]}
            >
              <Image src={entry.data.image} alt="" class="size-14 shrink-0 rounded-[2px] bg-ink-950 object-cover object-top sm:size-16" width={128} />
              <span class="min-w-0">
                <span class:list={['flex items-center gap-1.5 font-mono text-[10px] tracking-[0.2em] text-slate-500 uppercase', direction === 'next' && 'justify-end']}>
                  {direction === 'prev' && (
                    <svg class="size-3.5 transition-transform duration-300 group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"></path>
                    </svg>
                  )}
                  {label}
                  {direction === 'next' && (
                    <svg class="size-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
                    </svg>
                  )}
                </span>
                <span class="mt-1 block truncate text-sm font-semibold text-slate-300 transition-colors group-hover:text-white">{entry.data.name}</span>
                <span class="hidden truncate font-mono text-[10px] tracking-[0.18em] text-accent/80 uppercase sm:block">{entry.data.role}</span>
              </span>
            </a>
          ))
        }
      </nav>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .member-page {
    padding-top: calc(var(--header-h) + 3rem);
  }
</style>
